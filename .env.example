# Supabase — copy from Kura project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key
SUPABASE_SERVICE_KEY=your-secret-key

# Admin panel password — choose anything
ADMIN_PASSWORD=your-password-here

# iOS "Add to koji" Shortcut — any long random string; same value goes in the Shortcut (see VERDICTS.md)
KOJI_SHARE_TOKEN=your-long-random-token
